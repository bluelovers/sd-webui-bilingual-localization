{
  "name": "sd-webui-bilingual-localization",
  "version": "1.0.0",
  "description": "[中文文档](README_ZH.md) / [日本語](README_JA.md)",
  "private": true,
  "keywords": [
    "create-by-yarn-tool"
  ],
  "homepage": "https://github.com/journey-ad/sd-webui-bilingual-localization#readme",
  "bugs": {
    "url": "https://github.com/journey-ad/sd-webui-bilingual-localization/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/journey-ad/sd-webui-bilingual-localization.git"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "bilingual_localization.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "review": "pnpm run review:coverage",
    "review:coverage": "pnpm run lint && pnpm run coverage",
    "review:test": "pnpm run lint && pnpm run test",
    "coverage": "pnpm run test -- --coverage",
    "lint": "pnpm run lint:eslint",
    "lint:eslint": "ynpx eslint --ext .ts,.tsx,.mts,.cts ./",
    "pretest": "echo pretest",
    "test": "echo pnpm run test:jest",
    "test:jest": "jest --passWithNoTests",
    "test:jest:clearCache": "jest --clearCache",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:mocha": "ynpx --quiet -p ts-node -p mocha mocha -- --require ts-node/register \"!(node_modules)/**/*.{test,spec}.{ts,tsx}\"",
    "test:snapshot": "pnpm run test -- -u",
    "test:tsd": "ynpx tsd",
    "test:tsdx": "ynpx @bluelovers/tsdx test --passWithNoTests",
    "install:frozenLockfile": "yarn-tool install --frozen-lockfile",
    "install:resetLockfile": "yarn-tool install --reset-lockfile",
    "build": "tsx ./build.ts",
    "build:dts:bundle": "ynpx @bluelovers/dts-bundle-generator -o ./dist/index.d.ts ./src/index.ts --no-banner --inline-declare-global & echo build:dts:bundle",
    "build:dts:copy": "copy .\\src\\index.d.ts .\\dist\\index.d.ts & echo build:dts",
    "build:dts:tsc": "pnpm run build:dts:tsc:emit && pnpm run build:dts:copy",
    "build:dts:tsc:emit": "tsc --emitDeclarationOnly --declaration --noEmit false",
    "build:microbundle": "ynpx microbundle --target node",
    "build:tsdx": "ynpx @bluelovers/tsdx build --target node --name index",
    "ci:install": "pnpm install --frozen-lockfile && pnpm add -w yarn-tool lerna@6 ynpx ts-node ts-jest jest typescript@next @bluelovers/jest-config tsx",
    "ci:build": "pnpm run postpublish:changelog && pnpm run ci:build:core && pnpm run ci:build:commit && pnpm run postpublish",
    "ci:build:core": "tsx ./build.ts && tsx ./test/scripts/copy.ts",
    "ci:build:commit": "git add ./output & echo ci:build:commit",
    "npm:publish": "npm publish",
    "npm:publish:bump": "pnpm run version:bump && npm publish",
    "npm:publish:bump:major": "pnpm run version:bump:major && npm publish",
    "npm:publish:bump:minor": "pnpm run version:bump:minor && npm publish",
    "npm:publish:bump:patch": "pnpm run version:bump:patch && npm publish",
    "npm:publish:bump:prerelease": "pnpm run version:bump:prerelease && npm publish",
    "ws:fix-all": "yarn-tool fix-all  --overwriteHostedGitInfo",
    "ws:fix-all:resetStaticFiles": "pnpm run ws:fix-all -- --resetStaticFiles",
    "preversion": "echo preversion && pnpm run test",
    "version": "echo version",
    "version:bump": "yarn-tool version",
    "version:bump:major": "pnpm run version:bump -- --bump major",
    "version:bump:minor": "pnpm run version:bump -- --bump minor",
    "version:bump:patch": "pnpm run version:bump -- --bump patch",
    "version:bump:prerelease": "pnpm run version:bump -- --bump prerelease",
    "postversion": "echo postversion",
    "prepublish": "echo prepublish",
    "prepare": "echo prepare",
    "prepublishOnly": "pnpm run preversion",
    "prepublishOnly:check-bin": "ynpx --quiet @yarn-tool/check-pkg-bin",
    "prepack": "echo prepack",
    "pack": "echo pack",
    "postpack": "echo postpack",
    "publish": "echo publish",
    "postpublish": "pnpm run postpublish:git:commit && pnpm run postpublish:git:tag && pnpm run postpublish:git:push",
    "postpublish:changelog": "ynpx --quiet @yarn-tool/changelog && git add ./CHANGELOG.md & echo postpublish:changelog",
    "postpublish:git:commit": "git commit -m \"chore(release): publish\" & echo postpublish:git:commit",
    "postpublish:git:push": "git push --follow-tags",
    "postpublish:git:tag": "ynpx --quiet @yarn-tool/tag -- -f",
    "postpublishOnly": "echo postpublishOnly",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:default": "tsc -p tsconfig.json",
    "tsc:esm": "tsc -p tsconfig.esm.json",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {},
  "devDependencies": {
    "@bluelovers/tsconfig": "^2.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.2.0",
    "core-js-pure": "^3.50.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-sass-plugin": "^3.7.0",
    "fs-extra": "^11.4.0",
    "stable-diffusion-webui-types": "^1.0.3",
    "ts-type": "^3.0.13",
    "tslib": ">=2"
  },
  "packageManager": "pnpm@12.0.0-rc.7"
}
